# Server
PORT=8000
ORIGIN=http://localhost:3000
PRODUCTION=false
COOKIE_EXPIRATION_DAYS=30
SECRET_KEY=replace-me
LOGIN_TOKEN_EXPIRATION=30d
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d
PASSWORD_RESET_TOKEN_EXPIRATION=15m
OTP_EXPIRATION_TIME=120000
SHIPPING_FEE=5.55
TAXES_FEE=5

# Payments
CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET_HASH=

# Optional: one-time admin bootstrap (used by `npm run create-admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# Database
MONGO_URI=

# SendGrid (replaces Nodemailer)
# Create an API key at https://app.sendgrid.com/settings/api_keys
# Sender must be verified in SendGrid (Single Sender or Domain)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Shopora
